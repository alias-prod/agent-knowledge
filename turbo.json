{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env*"],
  "globalEnv": [
    "NEXT_PUBLIC_CONVEX_URL",
    "NEXT_PUBLIC_CONVEX_SITE_URL",
    "CONVEX_URL",
    "CONVEX_SITE_URL",
    "BETTER_AUTH_URL",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_ENV",
    "VERCEL_TARGET_ENV",
    "VERCEL_BRANCH_URL",
    "AUTH_PREVIEW_ORIGINS",
    "V0_RUNTIME_URL",
    "V0_DEV_APP_URL",
    "V0_BUILD_URL",
    "V0_SANDBOX_URL"
  ],
  "globalPassThroughEnv": [
    "CONVEX_DEPLOY_KEY",
    "BETTER_AUTH_SECRET",
    "RESEND_API_KEY",
    "RESEND_EMAIL_DOMAIN"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
