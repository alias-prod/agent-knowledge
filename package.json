{
  "name": "agent-knowledge",
  "private": true,
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "check:runtime": "node scripts/check-runtime.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@vitejs/plugin-react": "^6.0.5",
    "convex-test": "0.0.54",
    "jsdom": "^30.0.1",
    "turbo": "^2.9.15",
    "vitest": "^4.1.10",
    "@playwright/test": "1.64.1"
  },
  "dependencies": {
    "@agent-knowledge/shared": "workspace:*",
    "@convex-dev/better-auth": "0.12.5",
    "better-auth": "1.6.33",
    "convex": "^1.39.1",
    "convex-helpers": "0.1.120",
    "resend": "6.33.0",
    "yjs": "^13.6.33"
  },
  "engines": {
    "node": ">=22.22.2 <23",
    "bun": "1.4.3"
  },
  "patchedDependencies": {
    "@convex-dev/better-auth@0.12.5": "patches/@convex-dev%2Fbetter-auth@0.12.5.patch"
  }
}
